# ============================================================================
# OpenClaw 完整功能镜像构建配置文件
# 根据需要修改此配置，然后运行: ./build-full.sh
# ============================================================================

# ============================================================================
# 功能开关
# ============================================================================

# 安装 Go 环境（lark-cli 需要）
INSTALL_GO=true

# 安装 npm 全局工具
INSTALL_NPM_TOOLS=true

# 安装浏览器自动化（Playwright + Chromium + VNC）
INSTALL_BROWSER=true

# 构建后自动创建去掉 v 前缀的兼容 tag（例如 v2026.5.5 -> 2026.5.5）
TAG_COMPAT_ALIAS=true

# ============================================================================
# 工具版本配置
# ============================================================================

GO_VERSION=1.24.9
NPM_VERSION=11.12.1

# ============================================================================
# APT 包分类配置
# 按需要添加/删除包，或设置为空禁用该分类
# ============================================================================

# 核心系统工具
APT_PACKAGES_CORE="procps hostname curl wget git openssl ca-certificates gnupg sudo locales bash-completion"

# 开发构建工具
APT_PACKAGES_DEV="build-essential pkg-config python3 python3-pip python3-venv python3-dev cmake ninja-build gdb clang llvm make"

# 浏览器相关
APT_PACKAGES_BROWSER="chromium chromium-driver xvfb x11vnc novnc websockify"

# Playwright 依赖
APT_PACKAGES_PLAYWRIGHT="libgbm1 libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libasound2"

# 字体（支持中文显示）
APT_PACKAGES_FONTS="fonts-liberation fonts-noto-color-emoji fonts-wqy-zenhei fonts-wqy-microhei"

# 媒体处理
APT_PACKAGES_MEDIA="ffmpeg"

# 文档处理（PDF, OCR, Office）
APT_PACKAGES_DOCS="poppler-utils tesseract-ocr tesseract-ocr-eng tesseract-ocr-chi-sim gnumeric libreoffice-calc csvkit"

# 网络工具
APT_PACKAGES_NET="netcat-openbsd dnsutils iputils-ping socat traceroute mtr-tiny telnet tcpdump nmap"

# 归档工具
APT_PACKAGES_ARCHIVE="zip unzip p7zip-full"

# 终端增强工具
APT_PACKAGES_TERMINAL="tmux vim less htop iotop jq tree ripgrep zsh fzf fd-find bat git-lfs"

# 任务调度
APT_PACKAGES_SCHED="cron at"

# 系统监控/调试
APT_PACKAGES_SYS="rsync strace lsof file inotify-tools"

# X11 相关
APT_PACKAGES_X11="x11-apps x11-utils xauth dbus-x11"

# 其他工具（数据库客户端等）
APT_PACKAGES_OTHER="libasound2-dev sqlite3 libsqlite3-dev redis-tools postgresql-client default-mysql-client shellcheck"

# 额外自定义包（在此添加你需要的包）
APT_PACKAGES_EXTRA=""

# ============================================================================
# Python 包分类配置
# ============================================================================

PIP_PACKAGES_BASE="pip setuptools wheel"
PIP_PACKAGES_HTTP="requests httpx aiohttp urllib3"
PIP_PACKAGES_CONFIG="pydantic pyyaml python-dotenv"
PIP_PACKAGES_CLI="rich click typer tenacity invoke httpie"
PIP_PACKAGES_DOCS="beautifulsoup4 lxml markdown mkdocs mkdocs-material"
PIP_PACKAGES_OFFICE="pdfplumber pymupdf python-docx openpyxl xlrd xlwt pyxlsb"
PIP_PACKAGES_DATA="pandas numpy jmespath jsonschema tiktoken pillow polars pyarrow"
PIP_PACKAGES_TEST="pytest pytest-xdist pytest-asyncio ipython black ruff mypy"

# 额外自定义 Python 包
PIP_PACKAGES_EXTRA=""

# ============================================================================
# npm 全局工具
# ============================================================================

NPM_GLOBAL_TOOLS="skillhub@latest clawhub@latest typescript@latest tsx@latest npm-check-updates@latest eslint@latest prettier@latest @biomejs/biome@latest"

# ============================================================================
# 镜像源配置（国内加速）
# ============================================================================

# Debian APT 镜像源（为空使用官方源，推荐阿里云: mirrors.aliyun.com）
APT_MIRROR=mirrors.aliyun.com

# Python PIP 镜像源（为空使用官方源，推荐清华: https://pypi.tuna.tsinghua.edu.cn/simple）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# Go 模块代理
GOPROXY=https://goproxy.cn,direct
