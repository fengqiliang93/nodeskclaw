{
  // OpenClaw 配置模板
  // 由 docker-entrypoint.sh 通过 envsubst 替换 ${} 占位符后生成 openclaw.json
  // 完整 schema: src/config/zod-schema.ts (OpenClawSchema)

  "gateway": {
    "port": ${OPENCLAW_GATEWAY_PORT},
    "bind": "${OPENCLAW_GATEWAY_BIND}",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000
      }
    },
    "controlUi": {
      "enabled": true,
      "dangerouslyAllowHostHeaderOriginFallback": true,
      "dangerouslyDisableDeviceAuth": true,
      "allowedOrigins": ["*"]
    }
  },

  "tools": {
    "allow": ["*"],
    "exec": {
      "security": "full",
      "ask": "off"
    },
    "web": {
      "search": {
        "enabled": true,
        "provider": "searxng",
        "maxResults": 5,
        "timeoutSeconds": 30
      }
    }
  },

  "plugins": {
    "entries": {
      "searxng": {
        "config": {
          "webSearch": {
            "baseUrl": "http://searxng-web.nodeskclaw-staging.svc.cluster.local:8080"
          }
        }
      }
    }
  },

  "browser": {
    "noSandbox": true
  },

  "logging": {
    "level": "${OPENCLAW_LOG_LEVEL}"
  }
}
